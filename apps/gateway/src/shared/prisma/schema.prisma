generator client {
  provider     = "prisma-client"
  output       = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==================== AUTH SCHEMA ====================
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatar    String?
  role      String   @default("GUEST")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
