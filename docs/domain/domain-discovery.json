{
  "glossary": [
    {
      "term": "Usuario",
      "type": "Actor",
      "definition": "Persona que accede a la plataforma y puede tener distintos roles y tipos de cuenta (freelancer, organización)."
    },
    {
      "term": "Organización",
      "type": "Entidad",
      "definition": "Agrupación de usuarios con membresías, límites y planes de servicio."
    },
    {
      "term": "Plan",
      "type": "Valor",
      "definition": "Nivel de servicio que determina límites y características para una organización."
    },
    {
      "term": "Workspace",
      "type": "Entidad",
      "definition": "Espacio colaborativo personal o de organización, con miembros y roles definidos."
    },
    {
      "term": "Equipo",
      "type": "Entidad",
      "definition": "Subgrupo dentro de un workspace para organizar usuarios y proyectos."
    },
    {
      "term": "Proyecto",
      "type": "Entidad",
      "definition": "Iniciativa colaborativa con miembros, roles, estado, prioridad, fechas y etiquetas."
    },
    {
      "term": "Tarea",
      "type": "Entidad",
      "definition": "Unidad de trabajo tipo Kanban, con estados, prioridad, asignación y seguimiento."
    },
    {
      "term": "Enlace útil",
      "type": "Valor",
      "definition": "Recurso externo asociado a un proyecto para consulta o referencia."
    },
    {
      "term": "Credencial segura",
      "type": "Valor",
      "definition": "Información sensible asociada a un proyecto, almacenada de forma protegida."
    },
    {
      "term": "Notificación",
      "type": "Evento",
      "definition": "Aviso generado por cambios o acciones relevantes en el sistema."
    }
  ],
