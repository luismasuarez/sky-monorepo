{
  "name": "my-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:all": "turbo run dev",
    "build:all": "turbo run build",
    "lint:all": "turbo run lint",
    "typecheck:all": "turbo run typecheck",
    "frontend": "bunx turbo run dev --filter=@repo/frontend",
    "backend": "bunx turbo run dev --filter=@repo/backend"
  },
  "devDependencies": {
    "turbo": "^2.8.10"
  },
  "packageManager": "bun@1.3.7"
}