{
  "name": "my-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "backend": "bunx turbo run dev --filter=@repo/gateway",
    "template": "bunx turbo run dev --filter=@repo/ms-nestjs-template",
    "prisma:generate": "bunx turbo run prisma:generate",

    "services:up": "docker compose -f packages/infra/docker-compose.yml up -d",
    "services:down": "docker compose -f packages/infra/docker-compose.yml down",
    "services:build": "docker compose -f packages/infra/docker-compose.yml build",
    "services:restart": "docker compose -f packages/infra/docker-compose.yml restart",
    "services:logs": "docker compose -f packages/infra/docker-compose.yml logs -f --tail=200",
    "services:ps": "docker compose -f packages/infra/docker-compose.yml ps"
  },
  "devDependencies": {
    "turbo": "^2.8.10"
  },
  "packageManager": "bun@1.3.7"
}