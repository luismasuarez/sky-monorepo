{
  "name": "my-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:all": "turbo run dev",
    "build:all": "turbo run build",
    "lint:all": "turbo run lint",
    "typecheck:all": "turbo run typecheck",
    "backend": "bunx turbo run dev --filter=@repo/gateway",
    "template": "bunx turbo run dev --filter=@repo/ms-nestjs-template",
    "prisma:generate": "bunx turbo run prisma:generate"
  },
  "devDependencies": {
    "turbo": "^2.8.10"
  },
  "packageManager": "bun@1.3.7"
}