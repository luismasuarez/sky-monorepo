{
  "name": "@repo/infra",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "services:up": "docker compose -f docker-compose.yml up -d",
    "services:down": "docker compose -f docker-compose.yml down",
    "services:build": "docker compose -f docker-compose.yml build",
    "services:restart": "docker compose -f docker-compose.yml restart",
    "services:logs": "docker compose -f docker-compose.yml logs -f --tail=200",
    "services:ps": "docker compose -f docker-compose.yml ps"
  }
}