{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**",
        ".next/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "services:up": {
      "cache": false,
      "outputs": []
    },
    "services:down": {
      "cache": false,
      "outputs": []
    },
    "prisma:generate": {
      "dependsOn": [
        "^prisma:generate"
      ],
      "outputs": [
        "node_modules/.prisma/**",
        "src/shared/prisma/generated/**"
      ]
    },
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "outputs": []
    }
  }
}